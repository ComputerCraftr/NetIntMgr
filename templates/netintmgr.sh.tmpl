#!/bin/sh

# Exit on errors and undefined variables
set -eu

LOCK_BASE="/tmp/netintmgr.lock.d"
LOCK_PID_FILE="$LOCK_BASE/pid"
LOCK_WAIT_RETRIES=3
LOCK_WAIT_INTERVAL=1
ETHERNET_INTERFACES="__ETHERNET_INTERFACES__"
WIFI_INTERFACE="__WIFI_INTERFACE__"

log() {
    printf '%s\n' "$1"
}

log_err() {
    printf '%s\n' "$1" >&2
}

ensure_lock_paths() {
    if [ -L "$LOCK_BASE" ]; then
        log_err "Lock path must not be a symlink: $LOCK_BASE"
        return 1
    fi

    if [ -e "$LOCK_BASE" ] && [ ! -d "$LOCK_BASE" ]; then
        log_err "Lock path exists but is not a directory: $LOCK_BASE"
        return 1
    fi

    if [ -L "$LOCK_PID_FILE" ]; then
        log_err "Lock pid file must not be a symlink: $LOCK_PID_FILE"
        return 1
    fi

    if [ -e "$LOCK_PID_FILE" ] && [ ! -f "$LOCK_PID_FILE" ]; then
        log_err "Lock pid path exists but is not a regular file: $LOCK_PID_FILE"
        return 1
    fi
}

read_lock_pid() {
    cat "$LOCK_PID_FILE" 2>/dev/null || printf '%s' ""
}

lock_pid_is_valid() {
    case "$1" in
    "" | *[!0-9]*)
        return 1
        ;;
    *)
        return 0
        ;;
    esac
}

inspect_lock_state() {
    attempt=$1
    LOCK_STATE=""
    LOCK_OWNER_PID=""

    if ! ensure_lock_paths; then
        LOCK_STATE="lock-invalid-unsafe"
        return 0
    fi

    if [ ! -d "$LOCK_BASE" ]; then
        LOCK_STATE="lock-acquired"
        return 0
    fi

    if [ ! -e "$LOCK_PID_FILE" ]; then
        if [ "$attempt" -lt "$LOCK_WAIT_RETRIES" ]; then
            LOCK_STATE="lock-unknown-settling"
        else
            LOCK_STATE="lock-stale-safe-to-clear"
        fi
        return 0
    fi

    LOCK_OWNER_PID=$(read_lock_pid)

    if lock_pid_is_valid "$LOCK_OWNER_PID"; then
        if kill -0 "$LOCK_OWNER_PID" 2>/dev/null; then
            LOCK_STATE="lock-live-owned-by-other"
        elif [ "$attempt" -lt "$LOCK_WAIT_RETRIES" ]; then
            LOCK_STATE="lock-unknown-settling"
        else
            LOCK_STATE="lock-stale-safe-to-clear"
        fi
        return 0
    fi

    if [ "$attempt" -lt "$LOCK_WAIT_RETRIES" ]; then
        LOCK_STATE="lock-unknown-settling"
    else
        LOCK_STATE="lock-stale-safe-to-clear"
    fi
}

clear_stale_lock() {
    if ! ensure_lock_paths; then
        return 1
    fi

    if [ -f "$LOCK_PID_FILE" ] && ! rm -f -- "$LOCK_PID_FILE"; then
        log_err "Failed to remove stale lock pid file: $LOCK_PID_FILE"
        return 1
    fi

    if [ -d "$LOCK_BASE" ] && ! rmdir "$LOCK_BASE"; then
        log_err "Refusing to remove non-empty stale lock directory: $LOCK_BASE"
        return 1
    fi
}

release_lock() {
    exit_code=$?
    owner_pid=""

    trap - EXIT INT TERM HUP

    if ! ensure_lock_paths; then
        exit 1
    fi

    if [ ! -d "$LOCK_BASE" ]; then
        exit "$exit_code"
    fi

    if [ -f "$LOCK_PID_FILE" ]; then
        owner_pid=$(read_lock_pid)
    fi

    if [ "$owner_pid" = "$$" ]; then
        if [ -f "$LOCK_PID_FILE" ] && ! rm -f -- "$LOCK_PID_FILE"; then
            log_err "Failed to remove lock pid file: $LOCK_PID_FILE"
            exit 1
        fi

        if ! rmdir "$LOCK_BASE"; then
            log_err "Refusing to remove non-empty lock directory: $LOCK_BASE"
            exit 1
        fi
    fi

    exit "$exit_code"
}

acquire_lock() {
    while :; do
        if mkdir "$LOCK_BASE" 2>/dev/null; then
            break
        fi

        attempt=0
        while :; do
            inspect_lock_state "$attempt"

            case "$LOCK_STATE" in
            lock-acquired)
                break
                ;;
            lock-live-owned-by-other)
                log "Another instance is already running with pid $LOCK_OWNER_PID. Exiting."
                exit 0
                ;;
            lock-unknown-settling)
                attempt=$((attempt + 1))
                sleep "$LOCK_WAIT_INTERVAL"
                continue
                ;;
            lock-stale-safe-to-clear)
                log "Stale lock directory found. Removing..."
                clear_stale_lock
                break
                ;;
            lock-invalid-unsafe)
                exit 1
                ;;
            *)
                log_err "Unknown lock state: $LOCK_STATE"
                exit 1
                ;;
            esac
        done
    done

    if ! ensure_lock_paths; then
        exit 1
    fi

    if ! printf '%s\n' "$$" >"$LOCK_PID_FILE"; then
        log_err "Failed to write lock pid file: $LOCK_PID_FILE"
        clear_stale_lock
        exit 1
    fi
}

acquire_lock
trap 'release_lock' EXIT INT TERM HUP

check_ethernet_status() {
    for interface in $(printf '%s' "$ETHERNET_INTERFACES" | tr ',' '\n'); do
        if [ "$(ifconfig "$interface" 2>/dev/null | grep -c 'status: active')" -gt 0 ]; then
            return 0
        fi
    done
    return 1
}

get_wifi_power_state() {
    networksetup -getairportpower "$WIFI_INTERFACE" 2>/dev/null | awk '{print $NF}'
}

set_wifi_power() {
    desired_state=$1
    current_state=$(get_wifi_power_state || printf '%s' "")

    case "$desired_state:$current_state" in
    off:Off | on:On)
        return 0
        ;;
    esac

    networksetup -setairportpower "$WIFI_INTERFACE" "$desired_state"
}

if check_ethernet_status; then
    # Ethernet is connected, turn off Wi-Fi
    set_wifi_power off
else
    # Ethernet is not connected, turn on Wi-Fi
    set_wifi_power on
fi
